# Copy this file to srcs/.env (make does it for you) and adjust the values.
# No password belongs here: passwords live in ../secrets/ (see README.md).

LOGIN=gserafio
DOMAIN_NAME=gserafio.42.fr

# host directory that stores the two volumes
DATA_PATH=/home/gserafio/data

# MariaDB
DB_NAME=wordpress
DB_USER=wpuser

# WordPress (the administrator name must not contain "admin")
WP_TITLE=Inception
WP_ADMIN_USER=gserafio
WP_ADMIN_EMAIL=gserafio@gserafio.42.fr
WP_USER=reader42
WP_USER_EMAIL=reader42@gserafio.42.fr

# bonus: FTP
FTP_USER=ftpuser
